generator client {
  provider = "prisma-client"
  output   = "../src/infra/repositories/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUCTIONEER
  BIDDER
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            Role
  createdAt       DateTime         @default(now()) @map("created_at")
  walletMovements WalletMovement[]
  lots            Lot[]

  @@map("users")
}

/// Tipo do movimento da carteira. O valor é sempre positivo; o sinal vem do tipo (RF-40 a RF-42, RN-07).
enum WalletMovementType {
  DEPOSIT
  COMMIT
  RELEASE
  DEBIT
  CREDIT
  REFUND
}

/// Extrato da carteira, só de inserção: o saldo é derivado destas linhas (nunca update/delete).
model WalletMovement {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation(fields: [userId], references: [id])
  type           WalletMovementType
  /// Centavos inteiros, sempre > 0 (CHECK no banco).
  amountCents    Int                @map("amount_cents")
  /// Lote do movimento (COMMIT, RELEASE, DEBIT, CREDIT, REFUND). A relação com Lot entra no I2.
  lotId          String?            @map("lot_id") @db.Uuid
  /// Chave do cabeçalho Idempotency-Key (RN-18): única por usuário.
  idempotencyKey String?            @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("wallet_movements")
}

/// Lote do leilão. O estado (agendado, ao vivo, encerrado) deriva do relógio do servidor (RN-01);
/// só o cancelamento é gravado. Os dados do item, inclusive a imagem, são copiados da API externa
/// na criação (RN-13). Dinheiro em centavos inteiros (RN-16); datas em UTC (RN-17).
model Lot {
  id                String    @id @default(uuid()) @db.Uuid
  auctioneerId      String    @map("auctioneer_id") @db.Uuid
  auctioneer        User      @relation(fields: [auctioneerId], references: [id])
  externalId        String    @map("external_id")
  title             String
  attributes        Json
  imageData         Bytes     @map("image_data")
  imageContentType  String    @map("image_content_type")
  startingBidCents  Int       @map("starting_bid_cents")
  minIncrementCents Int       @map("min_increment_cents")
  startsAt          DateTime  @map("starts_at")
  originalEndsAt    DateTime  @map("original_ends_at")
  endsAt            DateTime  @map("ends_at")
  canceledAt        DateTime? @map("canceled_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([auctioneerId])
  @@index([endsAt])
  @@map("lots")
}

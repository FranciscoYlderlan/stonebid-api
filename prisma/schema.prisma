generator client {
  provider = "prisma-client"
  output   = "../src/infra/repositories/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUCTIONEER
  BIDDER
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            Role
  createdAt       DateTime         @default(now()) @map("created_at")
  walletMovements WalletMovement[]

  @@map("users")
}

/// Tipo do movimento da carteira. O valor é sempre positivo; o sinal vem do tipo (RF-40 a RF-42, RN-07).
enum WalletMovementType {
  DEPOSIT
  COMMIT
  RELEASE
  DEBIT
  CREDIT
  REFUND
}

/// Extrato da carteira, só de inserção: o saldo é derivado destas linhas (nunca update/delete).
model WalletMovement {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation(fields: [userId], references: [id])
  type           WalletMovementType
  /// Centavos inteiros, sempre > 0 (CHECK no banco).
  amountCents    Int                @map("amount_cents")
  /// Lote do movimento (COMMIT, RELEASE, DEBIT, CREDIT, REFUND). A relação com Lot entra no I2.
  lotId          String?            @map("lot_id") @db.Uuid
  /// Chave do cabeçalho Idempotency-Key (RN-18): única por usuário.
  idempotencyKey String?            @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("wallet_movements")
}

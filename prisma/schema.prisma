generator client {
  provider = "prisma-client"
  output   = "../src/infra/repositories/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUCTIONEER
  BIDDER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

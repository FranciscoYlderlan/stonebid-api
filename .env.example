# Copie para .env e ajuste. Nunca commite o .env.

# Ambiente: development | test | production
NODE_ENV=development

# Servidor HTTP
PORT=3333
HOST=0.0.0.0

# Banco PostgreSQL (no Compose, o host é "db")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stonebid

# Segredo do JWT (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Origens liberadas no CORS, separadas por vírgula (ex.: URL da Vercel)
CORS_ORIGIN=http://localhost:5173

# Senha dos usuários de teste criados pelo seed (npm run db:seed) e usada pela tool entrar do MCP
SEED_PASSWORD=stonebid123

# Camada MCP em /mcp: ligada em local e staging, desligada em produção
MCP_ENABLED=true
# Chave exigida em toda conexão com o /mcp (x-api-key ou Authorization: Bearer). Mínimo 16 caracteres.
MCP_API_KEY=troque-por-uma-chave-longa

# Teto por depósito simulado, em centavos (padrão 1000000 = R$ 10.000,00). Não há saque.
DEPOSIT_LIMIT_CENTS=1000000
